---
// 方法页 /m/<method>/：标题 + 引擎按钮；未接入的引擎渲染为不可点的「未接入」徽标。
import Base from '../../../layouts/Base.astro';
import { engines, methods, methodList, normalizeBase } from '../../../data/methods.js';

export function getStaticPaths() {
  return methodList().map(({ slug, zh }) => ({
    params: { method: slug },
    props: { zh },
  }));
}

const { zh } = Astro.props;
const slug = Astro.params.method;
const method = methods[slug];
const base = normalizeBase(import.meta.env.BASE_URL);
const activeEngines = engines.filter((e) => (method.engines ?? []).includes(e.id));
const placeholderEngines = method.placeholderEngines ?? [];
---
<Base title={`${zh} · Atlas`}>
  <article class="hub">
    <h1>{zh}</h1>

    <div class="engine-grid">
      {
        activeEngines.map((e) => (
          <a class="engine" href={`${base}/m/${slug}/${e.id}/`}>
            <span class="engine-name">{e.name}</span>
          </a>
        ))
      }
      {
        placeholderEngines.map((name) => (
          <span class="engine engine-ph" aria-disabled="true">
            <span class="engine-name">{name}</span>
            <span class="ph-badge">未接入</span>
          </span>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .hub { padding-top: 2.6rem; }
  h1 {
    font-size: 2.1rem;
    margin: 0 0 2.2rem;
  }

  .engine-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  @media (max-width: 560px) {
    .engine-grid { grid-template-columns: 1fr; }
  }
  .engine {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.engine:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }
  .engine-name {
    font-family: Georgia, "Songti SC", serif;
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* 未接入引擎：与按钮同构，但虚线边框、弱化配色、无交互 */
  .engine-ph {
    cursor: default;
    color: var(--muted);
    border-style: dashed;
  }
  .ph-badge {
    font-family: "SF Mono", ui-monospace, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    border: 1px dashed var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
</style>
