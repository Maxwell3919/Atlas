---
import Base from '../../../layouts/Base.astro';
import { engines, methods, methodList, normalizeBase } from '../../../data/methods.js';
import { methodTeaching, manualTeaching } from '../../../data/teaching.js';
import { availableManualIds } from '../../../lib/manual.js';
export function getStaticPaths() {
  return methodList().map(({ slug, zh }) => ({ params: { method: slug }, props: { zh } }));
}
const { zh } = Astro.props;
const slug = Astro.params.method;
const method = methods[slug];
const base = normalizeBase(import.meta.env.BASE_URL);
const available = await availableManualIds();
const cases = engines.filter((engine) => method.engines.includes(engine.id) && available.has(`${slug}/${engine.id}`));
const otherEngines = engines.filter((engine) => method.engines.includes(engine.id) && !available.has(`${slug}/${engine.id}`));
---
<Base title={`${zh} · Atlas`}>
  <article class="hub">
    <p class="crumb"><a href={`${base}/?open=1`}>← 计算目录</a></p>
    <h1>{zh}</h1>
    <p class="overview">{methodTeaching[slug]?.overview}</p>
    <div class="cases">
      {cases.map((engine) => {
        const example = manualTeaching[`${slug}/${engine.id}`];
        return <a class="case" href={`${base}/m/${slug}/${engine.id}/`}>
          <span class="engine">{engine.name}<small>{example?.kind}</small></span>
          <strong>{example?.title ?? method.zh}</strong>
          <span class="description">{example?.summary}</span>
          <span class="enter">读这个算例 →</span>
        </a>;
      })}
    </div>
    {otherEngines.length > 0 && <p class="other">其他实现的算例：{otherEngines.map((engine) => engine.name).join('、')} 尚未收录。</p>}
  </article>
</Base>
<style>
  .hub { padding-top: 1.5rem; }
  .crumb { margin: 0 0 1.2rem; font-size: .88rem; }
  h1 { font-size: 2rem; margin: 0 0 1.1rem; }
  .overview { margin: 0 0 1.8rem; }
  .cases { display: grid; gap: 1rem; }
  .case { display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; padding: 1.15rem 1.3rem; border: 1px solid var(--line); border-radius: 9px; background: var(--card); color: var(--fg); }
  .case:hover { text-decoration: none; border-color: var(--accent); }
  .engine { color: var(--muted); font-size: .85rem; }
  .engine small { margin-left: .7rem; font-size: .75rem; }
  .case strong { font-family: Georgia, "Songti SC", serif; font-size: 1.16rem; font-weight: 600; }
  .description { font-size: .93rem; }
  .enter { color: var(--accent); font-size: .87rem; margin-top: .3rem; }
  .other { color: var(--muted); font-size: .82rem; margin: 1.5rem 0; }
</style>
