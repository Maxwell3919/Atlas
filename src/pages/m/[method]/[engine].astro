---
// 方法 × 引擎页 /m/<method>/{qe,vasp}/：唯一放操作内容的地方，正文均为待填充。
// 提及栏只放方法名链接（指向各方法的 HUB，绝不直连其他引擎页）。
// 恰好 7 个 H2，顺序锁定。
import Base from '../../../layouts/Base.astro';
import { engines, methods, methodList, normalizeBase } from '../../../data/methods.js';

export function getStaticPaths() {
  const routes = [];
  for (const m of methodList()) {
    for (const e of engines) {
      routes.push({ params: { method: m.slug, engine: e.id }, props: { m, e } });
    }
  }
  return routes;
}

const { m, e } = Astro.props;
const base = normalizeBase(import.meta.env.BASE_URL);
const hubUrl = `${base}/m/${m.slug}/`;
const needs = m.needs.map((s) => ({ slug: s, zh: methods[s].zh }));
---
<Base title={`${m.zh} · ${e.name} · Atlas`}>
  <article class="page">
    <p class="crumb">
      <a href={hubUrl}>← {m.zh}</a>
      <span class="crumb-slug">{m.slug}</span>
    </p>

    <h1>{m.zh}</h1>
    <p class="engine-line">{e.name}</p>

    {/* 提及栏：需要 ≤3 / 产出 ≤3 */}
    <div class="mention">
      <div class="mention-row">
        <span class="mention-label">需要</span>
        {
          needs.length > 0 ? (
            needs.map((n) => (
              <a href={`${base}/m/${n.slug}/`}>{n.zh}</a>
            ))
          ) : (
            <span class="mention-plain">—</span>
          )
        }
      </div>
      <div class="mention-row">
        <span class="mention-label">产出</span>
        {m.produces.map((p) => <span class="mention-plain">{p}</span>)}
      </div>
    </div>

    <section>
      <h2>需要 / 产出</h2>
      <p class="fill">待填充</p>
    </section>

    <section>
      <h2>本步与相邻步骤不同之处</h2>
      <p class="fill">待填充</p>
    </section>

    <section>
      <h2>参数（只列本步）</h2>
      <p class="fill">待填充</p>
    </section>

    <section>
      <h2>命令与输出</h2>
      <p class="fill">待填充</p>
    </section>

    <section>
      <h2>后处理</h2>
      <p class="fill">待填充</p>
    </section>

    <section>
      <h2>失败与假阳性</h2>
      <p class="fill">待填充</p>
    </section>

    <section>
      <h2>可选脚本 + 检查清单</h2>
      <p class="fill">待填充</p>
    </section>
  </article>
</Base>

<style>
  .page { padding-top: 1.4rem; }
  .crumb {
    margin: 0 0 1.6rem;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: 0.88rem;
  }
  .crumb-slug {
    font-family: "SF Mono", ui-monospace, Menlo, monospace;
    color: var(--muted);
    font-size: 0.78rem;
  }
  h1 { font-size: 1.9rem; margin: 0; }
  .engine-line {
    font-family: "SF Mono", ui-monospace, Menlo, monospace;
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    margin: 0.25rem 0 1.4rem;
  }

  .mention {
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: var(--card);
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  .mention-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-size: 0.92rem;
  }
  .mention-label {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    min-width: 3.2em;
  }
  .mention-plain { color: var(--fg); }

  section { margin-top: 2.5rem; }
  h2 {
    font-size: 1.18rem;
    margin: 0 0 0.7rem;
  }
  .fill {
    color: var(--muted);
    margin: 0;
  }
</style>
