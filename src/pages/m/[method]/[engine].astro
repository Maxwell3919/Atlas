---
import Base from '../../../layouts/Base.astro';
import ArticleBody from '../../../components/ArticleBody.astro';
import { engines, methods, methodList, normalizeBase, methodRouteAliases } from '../../../data/methods.js';
import { manualTeaching } from '../../../data/teaching.js';
import { availableManualIds, loadManualBody } from '../../../lib/manual.js';
export function getStaticPaths() {
  const routes = methodList().flatMap((method) => engines.filter((engine) => method.engines.includes(engine.id)).map((engine) => ({ params: { method: method.slug, engine: engine.id }, props: { m: method, e: engine } })));
  for (const [oldSlug, canonical] of Object.entries(methodRouteAliases)) {
    const method = { slug: canonical, ...methods[canonical] };
    for (const engine of engines.filter(engine => method.engines.includes(engine.id)))
      routes.push({ params: { method: oldSlug, engine: engine.id }, props: { m: method, e: engine } });
  }
  const model = engines.find(engine => engine.id === 'model');
  for (const legacyEngine of ['qe', 'vasp'])
    routes.push({ params: { method: 'bkt-scaling', engine: legacyEngine }, props: { m: { slug: 'bkt-scaling', ...methods['bkt-scaling'] }, e: model } });
  return routes;
}
const { m, e } = Astro.props;
const base = normalizeBase(import.meta.env.BASE_URL);
const example = manualTeaching[`${m.slug}/${e.id}`];
const available = await availableManualIds();
const direct = (slug) => `${base}/m/${slug}/${e.id}/`;
const inputs = (example?.inputs ?? []).filter((input) => available.has(`${input.method}/${e.id}`));
const related = (example?.related ?? []).filter((slug) => available.has(`${slug}/${e.id}`));
const body = await loadManualBody(m.slug, e.id);
---
<Base title={`${m.zh} · ${e.name} · Atlas`}>
  <article class="page">
    <p class="crumb"><a href={`${base}/m/${m.slug}/`}>← {m.zh}</a></p>
    <h1>{m.zh}</h1>
    <p class="case-line">{e.name}{example && <> · {example.title}</>}</p>
    {body && (inputs.length > 0 || related.length > 0) && <div class="connections">
      {inputs.length > 0 && <p><span class="label">接续文件</span>{inputs.map((input, index) => <>{index > 0 && '；'}<a href={direct(input.method)}>{input.label}</a></>)}</p>}
      {related.length > 0 && <p><span class="label">方法参考</span>{related.map((slug, index) => <>{index > 0 && ' · '}<a href={direct(slug)}>{methods[slug].zh}</a></>)}</p>}
    </div>}
    {body ? <ArticleBody body={body} /> : <p class="empty">这一实现的算例尚未收录。<a href={`${base}/m/${m.slug}/`}>查看已有算例 →</a></p>}
  </article>
</Base>
<style>
  .page { padding-top: 1.5rem; }
  .crumb { margin: 0 0 1.2rem; font-size: .88rem; }
  h1 { font-size: 1.9rem; margin: 0; }
  .case-line { color: var(--muted); font-size: .84rem; margin: .4rem 0 1.3rem; }
  .connections { font-size: .86rem; line-height: 1.7; border-bottom: 1px solid var(--line); margin-bottom: 1.3rem; padding-bottom: .8rem; }
  .connections p { margin: .3rem 0; }
  .label { color: var(--muted); margin-right: .7rem; }
  .empty { color: var(--muted); margin-top: 1.6rem; }
</style>
