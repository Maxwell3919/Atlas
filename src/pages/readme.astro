---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import ArticleBody from '../components/ArticleBody.astro';
import { renderMarkdownBody } from '../lib/manual.js';
const body = await renderMarkdownBody(readFileSync(resolve('src/content/learning/readme.md'), 'utf8'));
---
<Base title="README · Atlas">
  <article class="readme">
    <h1>README</h1>
    <ArticleBody body={body} contents={false} />
  </article>
</Base>
