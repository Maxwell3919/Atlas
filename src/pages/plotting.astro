---
import Base from '../layouts/Base.astro';
import raw from '../data/plotting.md?raw';
import ArticleBody from '../components/ArticleBody.astro';
import { renderMarkdownBody } from '../lib/manual.js';
const body = await renderMarkdownBody(raw);
---
<Base title="科研图的后处理与导出 · Atlas">
  <article class="plotting">
    <h1>科研图的后处理与导出</h1>
    <ArticleBody body={body} />
  </article>
</Base>
