---
import { readFileSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { renderMarkdownBody } from '../../lib/manual.js';
import { normalizeBase } from '../../data/methods.js';
const base=normalizeBase(import.meta.env.BASE_URL);
let body=await renderMarkdownBody(readFileSync('src/content/cases/abinit-h2.md','utf8').replace(/^# [^\n]+\n/,''));
// Presentation only: keep Markdown, original image and adjacent CSV unchanged.
const figurePattern=/(<figure class="research-figure">[\s\S]*?scf-convergence\.png[\s\S]*?<\/figcaption>)(<\/figure>)/g;
if(!figurePattern.test(body)) throw new Error('Expected ABINIT scientific figure missing');
let figureNumber=0;
body=body.replace(figurePattern, (_match,figure,end) => {
 const src=figure.match(/<img[^>]*src="([^"]+)"/)?.[1];
 if(!src) throw new Error('Scientific figure source missing');
 const helpId=`abinit-pan-help-${++figureNumber}`;
 return `${figure}
<div class="abinit-figure-reader">
 <p class="abinit-figure-context">NC-LDA / 10 Ha / 10 Bohr 周期盒；基组、盒长、力准确性未确立。左轴：相对末态能量（Ha）；右轴：相邻绝对能差（Ha）；虚线：toldfe = 1e-6 Ha。初始密度裁剪，后续及最终裁剪前负密度 UNKNOWN。</p>
 <p><a class="abinit-original" href="${src}" target="_blank" rel="noopener">打开原尺寸 PNG（新标签页，可放大） ↗</a></p>
 <details class="abinit-enlarged">
  <summary>展开原尺寸图：左右滑动查看坐标与阈值</summary>
  <p id="${helpId}">图保持原始 1620 × 684 像素。触屏左右滑动；键盘聚焦图框后用左右方向键。收起可返回正文。</p>
  <div class="abinit-pan" tabindex="0" role="region" aria-label="原尺寸 SCF 图，可横向滚动" aria-describedby="${helpId}"><img src="${src}" width="1620" height="684" alt="原尺寸 SCF 图：NC-LDA、10 Ha、10 Bohr；能量 Ha、相邻能差 Ha、toldfe 1e-6 Ha；准确性未确立"></div>
 </details>
</div>${end}`;
});

---
<Base title="ABINIT H₂：六步原生 SCF · Atlas"><article class="record"><p>← ABINIT 安装与输入 · <a href={`${base}/software/`}>软件算例</a></p><h1>ABINIT H₂：固定设置下的能量、六步原生 SCF</h1><ArticleBody body={body}/></article></Base>

<style>
 .record :global(.abinit-figure-reader){margin:.8rem 0 1rem}
 .record :global(.abinit-figure-context){font-size:.95rem;line-height:1.75;color:var(--fg)}
 .record :global(.abinit-original){display:inline-block;padding:.65rem .8rem;border:1px solid var(--accent);border-radius:6px;font-size:1rem;font-weight:600}
 .record :global(.abinit-enlarged summary){padding:.7rem .2rem;font-size:1rem;font-weight:600;cursor:pointer}
 .record :global(.abinit-enlarged > p){font-size:.9rem}
 .record :global(.abinit-pan){max-width:100%;overflow:auto;border:1px solid var(--line);background:white;overscroll-behavior-x:contain}
 .record :global(.abinit-pan img){display:block;width:1620px;max-width:none;height:684px;margin:0;border:0;border-radius:0}
 .record :global(.abinit-pan:focus-visible),.record :global(.abinit-original:focus-visible),.record :global(.abinit-enlarged summary:focus-visible){outline:2px solid var(--accent);outline-offset:3px}
</style>
