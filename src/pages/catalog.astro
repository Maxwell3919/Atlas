---
import Base from '../layouts/Base.astro';
import MethodDirectory from '../components/MethodDirectory.astro';
import { normalizeBase } from '../data/methods.js';
import '../styles/home.css';
const base=normalizeBase(import.meta.env.BASE_URL);
---
<Base title="性质目录 · Atlas" wide><article class="atlas-home catalog-page"><p><a href={`${base}/?open=1`}>← 首页</a></p><h1>性质目录</h1><MethodDirectory expanded /></article></Base>
<style>.catalog-page{padding-top:1rem}.catalog-page>p{font-size:.85rem;margin-bottom:1.8rem}.catalog-page h1{font-size:2rem;font-weight:500;margin-bottom:1.8rem}</style>
