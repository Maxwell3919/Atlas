---
// 首页：只放奶牛猫 +「Click it.」；点击后才展开方法目录（页内切换，可再点收起）。
// 目录首位为 README 条目，其后按分类列出方法。
import Base from '../layouts/Base.astro';
import CowCat from '../components/CowCat.astro';
import { categories, methods, normalizeBase } from '../data/methods.js';
import { availableManualIds } from '../lib/manual.js';

const base = normalizeBase(import.meta.env.BASE_URL);
const available = await availableManualIds();
const ready = (slug) => ['qe', 'vasp'].some((engine) => available.has(`${slug}/${engine}`));
const publishedCategories = categories.map((c) => ({ ...c, order: c.order.filter(ready) })).filter((c) => c.order.length);
const unpublished = categories.flatMap((c) => c.order).filter((slug) => !ready(slug));
---
<Base title="Atlas · DFT 计算方法手册">
  <div class="home">
    <button
      id="cat-toggle"
      class="cat-btn"
      type="button"
      aria-expanded="false"
      aria-controls="dir"
    >
      <CowCat />
      <span class="hint">Click it.</span>
    </button>

    <section id="dir" class="dir" aria-label="方法目录">
      <div class="dir-inner">
        <div class="readme-slot">
          <a class="readme-entry" href={`${base}/readme/`}>
            <span class="readme-label">README <small>作者说明尚未发布</small></span>
            <span class="readme-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="group reading-routes">
          <h2>沿一个问题读下去</h2>
          <p><a href={`${base}/m/vc-relax/qe/`}>结构优化的失败行</a> → <a href={`${base}/m/scf/qe/`}>固定结构 SCF</a> → <a href={`${base}/m/dos/qe/`}>DOS 图</a> / <a href={`${base}/m/bands/qe/`}>能带图</a></p>
          <p><a href={`${base}/m/phonon-dfpt/qe/`}>逐 q 文件到声子图</a> → <a href={`${base}/m/imaginary-phonon/qe/`}>核对原始频率</a> → <a href={`${base}/m/eliashberg-a2f/qe/`}>读取展宽扫描</a></p>
          <p><a href={`${base}/m/exfoliation-energy/vasp/`}>移动一层后，能量怎样变化</a></p>
        </div>
        {
          publishedCategories.map((c) => (
            <div class="group">
              <h2>{c.name}</h2>
              <ul>
                {c.order.map((slug) => (
                  <li>
                    <a href={`${base}/m/${slug}/`}>{methods[slug].zh}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <details class="more-methods">
          <summary>其他方法 · 尚无算例（{unpublished.length}）</summary>
          <p>以下方法保留在目录中，已有正文的条目列在上方。</p>
          <ul>{unpublished.map((slug) => <li>{methods[slug].zh}</li>)}</ul>
        </details>
      </div>
    </section>
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 11vh;
  }
  .cat-btn {
    background: none;
    border: none;
    padding: 0.5rem 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    border-radius: 14px;
    -webkit-tap-highlight-color: transparent;
  }
  .cat-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .hint {
    font-family: Georgia, "Songti SC", serif;
    font-style: italic;
    font-size: 1.15rem;
    color: var(--muted);
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }
  .cat-btn:hover .hint { color: var(--fg); }

  /* 展开目录：grid-rows 0fr -> 1fr 平滑展开 */
  .dir {
    width: 100%;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dir.open { grid-template-rows: 1fr; }
  .dir-inner { overflow: hidden; }

  /* README 条目：目录第一槽位，整行强调，区别于方法药丸 */
  .readme-slot {
    margin-top: 2.2rem;
    margin-bottom: 0.4rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease 0.15s, transform 0.4s ease 0.15s;
  }
  .dir.open .readme-slot { opacity: 1; transform: none; }
  .readme-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: var(--card);
    color: var(--fg);
    font-size: 0.95rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .readme-entry:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
  }
  .readme-label {
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0.05em;
  }
  .readme-arrow {
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .readme-entry:hover .readme-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .group {
    margin-top: 1.6rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s;
  }
  .dir.open .group { opacity: 1; transform: none; }
  .group h2 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
    margin: 0 0 0.7rem;
    letter-spacing: 0.14em;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .group a {
    display: inline-block;
    padding: 0.32rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--fg);
    font-size: 0.92rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .group a:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .more-methods { margin-top: 2rem; color: var(--muted); font-size: .88rem; }
  .readme-label small { font: .74rem -apple-system, sans-serif; color: var(--muted); margin-left: .65rem; }
  .reading-routes { border-bottom: 1px solid var(--line); padding-bottom: 1.2rem; }
  .reading-routes p { font-size: .88rem; margin: .55rem 0; }
  .reading-routes a { border: none; background: none; border-radius: 0; padding: 0; color: var(--accent); }
  .more-methods summary { cursor: pointer; }
  .more-methods ul { columns: 2; padding-left: 1.2rem; }
  @media (max-width: 560px) { .more-methods ul { columns: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .dir, .readme-slot, .group { transition: none; }
  }
</style>

<script>
  const btn = document.getElementById('cat-toggle');
  const dir = document.getElementById('dir');
  if (btn && dir) {
    btn.addEventListener('click', () => {
      const open = dir.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
