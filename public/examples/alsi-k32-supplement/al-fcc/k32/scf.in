&CONTROL
 calculation = 'scf'
 prefix = 'al-fcc'
 outdir = './tmp'
 pseudo_dir = '../../pseudo'
 tstress = .true.
 tprnfor = .true.
/
&SYSTEM
 ibrav = 0
 nat = 1
 ntyp = 1
 nbnd = 6
 ecutwfc = 80
 ecutrho = 640
 occupations = 'smearing'
 smearing = 'mv'
 degauss = 0.005
/
&ELECTRONS
 startingpot = 'file'
 startingwfc = 'atomic+random'
 conv_thr = 1.0d-10
 diagonalization = 'cg'
 diago_cg_maxiter = 1000
 diago_thr_init = 1.0d-6
/
ATOMIC_SPECIES
Al 26.9815385 Al.pbe-n-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
-2.021405381541 0.000000000000 2.021405381541
0.000000000000 2.021405381541 2.021405381541
-2.021405381541 2.021405381541 0.000000000000
ATOMIC_POSITIONS crystal
Al 0.000000000000 0.000000000000 0.000000000000
K_POINTS automatic
32 32 32 0 0 0
