&CONTROL
  calculation = 'relax'
  etot_conv_thr =   1.0000000000d-08
  forc_conv_thr =   1.0000000000d-08
  outdir = './out_rx/'
  prefix = 'zrclscc'
  pseudo_dir = './pseudo/'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0,
  nat = 6,
  ntyp = 4,
  ecutwfc = 100,
  ecutrho = 800,
  input_dft = 'vdw-DF3-opt1'
  force_symmorphic =.true.
  occupations = 'smearing',
  smearing = 'gaussian',
  degauss = 3.7d-3
/
&ELECTRONS
! diagonalization = 'cg'
  conv_thr =   1.0000000000d-08
  electron_maxstep = 200
  mixing_beta =   4.0000000000d-01
/
&ions
/
&cell
cell_dofree='2Dxy'
/
