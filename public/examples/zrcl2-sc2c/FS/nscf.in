&CONTROL
  calculation = 'nscf'
  outdir = './out/'
  prefix = 'zrclscc'
  pseudo_dir = './pseudo/'
! tprnfor = .true.
! tstress = .true.
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0,
  nat = 6,
  ntyp = 4,
  ecutwfc = 100,
  ecutrho = 800,
  input_dft = 'vdw-DF3-opt1'
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 2.0d-3
/
&ELECTRONS
  conv_thr = 1.0000000000d-12
  mixing_beta = 4.0000000000d-01
/
&ions
/
&cell
/
