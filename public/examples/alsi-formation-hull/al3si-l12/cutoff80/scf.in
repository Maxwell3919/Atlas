&CONTROL
 calculation = 'scf'
 prefix = 'al3si-l12'
 outdir = './tmp'
 pseudo_dir = '../../pseudo'
 tstress = .true.
 tprnfor = .true.
/
&SYSTEM
 ibrav = 0
 nat = 4
 ntyp = 2
 nbnd = 14
 ecutwfc = 80
 ecutrho = 640
 occupations = 'smearing'
 smearing = 'mv'
 degauss = 0.005
/
&ELECTRONS
 conv_thr = 1.0d-10
 diagonalization = 'cg'
 diago_cg_maxiter = 200
 diago_thr_init = 1.0d-10
/
ATOMIC_SPECIES
Si 28.085 Si.pbe-n-rrkjus_psl.1.0.0.UPF
Al 26.9815385 Al.pbe-n-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
